{
  "name": "dsh-session-search",
  "version": "0.1.0",
  "type": "module",
  "description": "按字面（含中文单字）搜索本机 DSH 会话历史的插件：宿主侧解压 session 日志建索引，浏览器侧提供搜索面板。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session-search",
    "chinese"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puppet0721/dsh-session-search.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.1": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
